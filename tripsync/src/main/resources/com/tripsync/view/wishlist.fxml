<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tripsync.controller.WishlistController">

    <top>
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="wish-star-large" text="★" />
                <VBox spacing="3">
                    <Label styleClass="page-title" text="공동 위시리스트" />
                    <Label fx:id="tripContextLabel" styleClass="page-subtitle" text="" />
                </VBox>
            </HBox>

            <VBox spacing="9" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="field-label" text="장소명" />
                    <Label styleClass="field-required" text="*" />
                    <TextField fx:id="placeNameField" minWidth="200"
                               promptText="예: 우도 땅콩아이스크림" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="categoryComboBox" prefWidth="130" />
                    <TextField fx:id="noteField" prefWidth="200" promptText="메모 (선택)" />
                    <Button fx:id="addButton" styleClass="button-primary" text="＋ 추가" />
                </HBox>
                <Label fx:id="addErrorLabel" managed="false" styleClass="error-text" visible="false" />
            </VBox>

            <padding>
                <Insets bottom="14" />
            </padding>
        </VBox>
    </top>

    <center>
        <VBox styleClass="panel">
            <HBox alignment="CENTER_LEFT" spacing="9" styleClass="panel-header">
                <Label styleClass="section-title" text="후보 장소" />
                <HBox fx:id="tabBar" spacing="6" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="sampleButton" styleClass="button-ghost" text="샘플 채우기" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        styleClass="wish-grid-scroll">
                <content>
                    <FlowPane fx:id="wishGrid" hgap="14" vgap="14" styleClass="wish-grid" />
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
