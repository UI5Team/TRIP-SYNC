<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  화면 5 — 여행 상세 (핵심 화면)
  설계서 8장: 넓은 화면을 활용한 3분할 레이아웃.
    좌측 = 날짜별 일정 목록 / 중앙 = 선택 일정 상세 / 우측 = 공동 위시리스트 요약
-->
<BorderPane styleClass="page"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tripsync.controller.TripDetailController">

    <!-- 여행 머리말 -->
    <top>
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4">
                    <Label fx:id="tripTitleLabel" styleClass="page-title" text="여행" />
                    <Label fx:id="tripPeriodLabel" styleClass="page-subtitle" text="" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="openWishlistButton" styleClass="button-ghost" text="위시리스트 열기" />
                <Button fx:id="addScheduleButton" styleClass="button-primary" text="＋ 일정 추가" />
            </HBox>

            <!-- 날짜 선택: 여행 기간의 날짜가 버튼으로 깔린다 -->
            <HBox fx:id="dateTabBar" alignment="CENTER_LEFT" spacing="8" />

            <padding>
                <Insets bottom="18" />
            </padding>
        </VBox>
    </top>

    <!-- 3분할 본문 -->
    <center>
        <HBox spacing="16">

            <!-- ① 좌측: 날짜별 일정 목록 -->
            <VBox minWidth="250" prefWidth="300" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
                    <Label styleClass="section-title" text="일정 목록" />
                    <Label fx:id="scheduleCountLabel" styleClass="section-caption" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="scheduleListBox" spacing="9" styleClass="panel-body" />
                    </content>
                </ScrollPane>
            </VBox>

            <!-- ② 중앙: 선택한 일정의 상세 -->
            <VBox minWidth="330" styleClass="panel" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
                    <Label styleClass="section-title" text="일정 상세" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="editScheduleButton" styleClass="button-ghost" text="수정" />
                    <Button fx:id="deleteScheduleButton" styleClass="button-danger" text="삭제" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="scheduleDetailBox" spacing="14" styleClass="panel-body" />
                    </content>
                </ScrollPane>
            </VBox>

            <!-- ③ 우측: 공동 위시리스트 요약 -->
            <VBox minWidth="240" prefWidth="290" styleClass="panel">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
                    <Label styleClass="section-title" text="위시리스트" />
                    <Label fx:id="wishlistCountLabel" styleClass="section-caption" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="manageWishlistButton" styleClass="button-ghost" text="관리" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="wishlistSummaryBox" spacing="9" styleClass="panel-body" />
                    </content>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

</BorderPane>
