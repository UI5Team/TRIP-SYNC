<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16" styleClass="page"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tripsync.controller.TripDetailController">

    <VBox minWidth="340" prefWidth="380" maxWidth="420" styleClass="panel">

        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="panel-header">
            <Label styleClass="panel-icon" text="🗓" />
            <Label styleClass="section-title" text="일정" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="viewModeBar" spacing="0" styleClass="segmented" />
        </HBox>

        <VBox fx:id="calendarHolder" styleClass="calendar-holder" />

        <Separator styleClass="panel-divider" />

        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="day-header">
            <Label styleClass="panel-icon-small" text="🗓" />
            <Label fx:id="dayHeaderLabel" styleClass="day-header-title" text="" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="scheduleCountLabel" styleClass="section-caption" />
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                    styleClass="timeline-scroll">
            <content>
                <VBox fx:id="timelineBox" spacing="2" styleClass="timeline" />
            </content>
        </ScrollPane>

        <VBox styleClass="panel-footer">
            <Button fx:id="addScheduleButton" maxWidth="Infinity"
                    styleClass="add-schedule-button" text="＋ 일정 추가하기" />
        </VBox>
    </VBox>

    <BorderPane HBox.hgrow="ALWAYS" styleClass="panel">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="panel-header">
                <VBox spacing="2">
                    <Label fx:id="tripTitleLabel" styleClass="detail-trip-title" text="여행" />
                    <Label fx:id="tripPeriodLabel" styleClass="section-caption" text="" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="filterBar" alignment="CENTER_RIGHT" spacing="7" />
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="detail-scroll">
                <content>
                    <VBox fx:id="detailBox" spacing="16" styleClass="panel-body" />
                </content>
            </ScrollPane>
        </center>

        <bottom>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="panel-footer">
                <Label fx:id="detailHintLabel" styleClass="section-caption" text="" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="openWishlistButton" styleClass="button-ghost" text="위시리스트 열기" />
                <Button fx:id="editScheduleButton" styleClass="button-secondary" text="수정" />
                <Button fx:id="deleteScheduleButton" styleClass="button-danger" text="삭제" />
            </HBox>
        </bottom>
    </BorderPane>

</HBox>
