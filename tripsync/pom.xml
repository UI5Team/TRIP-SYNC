<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tripsync</groupId>
    <artifactId>tripsync</artifactId>
    <version>1.0.0</version>
    <name>TripSync</name>
    <description>완전 오프라인 JavaFX 여행 플래너 — 지능형 UI/UX 프로그래밍 5조</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <sqlite.version>3.45.3.0</sqlite.version>
        <main.class>com.tripsync.TripSyncApp</main.class>
    </properties>

    <dependencies>
        <!-- JavaFX: GUI 프레임워크. 외부 서버/웹 연동 없음 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- SQLite: 서버 없이 .db 파일 하나로 동작하는 로컬 데이터베이스 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!--
            sqlite-jdbc 가 로깅에 slf4j 를 쓴다. 구현체가 없으면 실행할 때마다
            "SLF4J: No providers were found" 경고가 콘솔에 뜬다.
            기능에는 지장이 없지만 시연 중에 오류처럼 보이므로,
            아무것도 출력하지 않는 구현체를 넣어 조용히 만든다.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- mvn javafx:run 으로 실행 -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
