<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  화면 4 — 여행 생성
  설계서 7장: 여행명·시작일·종료일 필수. 종료일은 시작일보다 빠를 수 없다.
-->
<VBox alignment="TOP_CENTER" styleClass="page"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tripsync.controller.TripCreateController">

    <VBox maxWidth="620" spacing="20" styleClass="page-narrow">

        <VBox spacing="5">
            <Label styleClass="page-title" text="새 여행 만들기" />
            <Label fx:id="groupContextLabel" styleClass="page-subtitle" text="" />
        </VBox>

        <VBox spacing="18" styleClass="card">

            <!-- 여행명 (필수) -->
            <VBox spacing="7">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <Label styleClass="field-label" text="여행명" />
                    <Label styleClass="field-required" text="*" />
                </HBox>
                <TextField fx:id="titleField" promptText="예: 제주 3박 4일" />
                <Label fx:id="titleErrorLabel" managed="false" styleClass="error-text" visible="false" />
            </VBox>

            <!-- 기간 (필수) -->
            <VBox spacing="7">
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <Label styleClass="field-label" text="여행 기간" />
                    <Label styleClass="field-required" text="*" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <DatePicker fx:id="startDatePicker" prefWidth="180" promptText="시작일" />
                    <Label styleClass="card-meta" text="→" />
                    <DatePicker fx:id="endDatePicker" prefWidth="180" promptText="종료일" />
                    <Label fx:id="durationLabel" styleClass="section-caption" />
                </HBox>
                <Label fx:id="dateErrorLabel" managed="false" styleClass="error-text" visible="false" />
            </VBox>

        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelButton" styleClass="button-ghost" text="취소" />
            <Button fx:id="submitButton" styleClass="button-primary" text="여행 만들기" />
        </HBox>

    </VBox>
</VBox>
