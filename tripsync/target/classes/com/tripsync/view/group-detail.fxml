<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  화면 3 — 모임 상세 및 여행 목록
  설계서 7장: 모임명, 초대 코드, 여행 목록, '새 여행 만들기' 버튼을 보여준다.
-->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tripsync.controller.GroupDetailController">
    <content>
        <VBox spacing="22" styleClass="page">

            <!-- 모임 정보 -->
            <VBox spacing="12" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="groupNameLabel" styleClass="page-title" text="모임" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="field-label" text="초대 코드" />
                    <Label fx:id="inviteCodeLabel" styleClass="invite-code" text="——————" />
                    <Button fx:id="copyCodeButton" styleClass="button-ghost" text="복사" />
                </HBox>
                <Label fx:id="memberLabel" styleClass="page-subtitle"
                       text="이 코드를 아는 사람이 모임에 참여할 수 있습니다." />
            </VBox>

            <!-- 여행 목록 -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="section-title" text="여행" />
                <Label fx:id="tripCountLabel" styleClass="section-caption" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="createTripButton" styleClass="button-primary" text="＋ 새 여행 만들기" />
            </HBox>

            <Label styleClass="section-caption"
                   text="모임 하나에 여행을 여러 개 만들 수 있습니다. 편집은 한 번에 한 여행씩 진행합니다." />

            <VBox fx:id="tripListBox" spacing="12">
                <padding>
                    <Insets bottom="10" />
                </padding>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
